APP_ENV=dev

# Match these values to your PostgreSQL instance. The defaults use the project name.
DATABASE__USER=__PROJECT_NAME__
DATABASE__PASSWORD=__PROJECT_NAME__
# DATABASE__HOST=localhost
# DATABASE__PORT=5432
# DATABASE__NAME=__PROJECT_NAME__

# Replace this value with a random secret of at least 32 bytes before using auth.
AUTH__TOKENS__SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
# AUTH__TOKENS__ACCESS_TOKEN_EXPIRE_MINUTES=60
